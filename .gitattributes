# Normalise line endings in the repository regardless of the contributor's OS.
* text=auto eol=lf

# client.js is generated by build.mjs (2 MB, single line): hide it from diffs and
# from GitHub's language statistics so reviews focus on src/.
client.js linguist-generated=true linguist-vendored=true diff=false -text

*.png binary
*.svg text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
