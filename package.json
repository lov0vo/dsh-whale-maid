{
  "name": "dsh-whale-maid",
  "version": "2.0.0",
  "private": true,
  "description": "Whale girl desktop pet for the DeepSeek Harness: twelve sprite animations, work-status link, growth, achievements, weather companion.",
  "license": "MIT",
  "author": "lov0vo",
  "homepage": "https://github.com/lov0vo/dsh-whale-maid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lov0vo/dsh-whale-maid.git"
  },
  "bugs": {
    "url": "https://github.com/lov0vo/dsh-whale-maid/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "assets",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "desktop-pet",
    "whale",
    "sprite",
    "companion",
    "tamagotchi",
    "achievements",
    "weather"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/companion.test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.1"
  }
}
